rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 관리자: Firestore 콘솔에서 admins 컬렉션에 "구글 이메일(소문자)"을 문서 ID로 추가하면 돼요.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower()));
    }

    match /admins/{email} {
      // 로그인한 사람이 "내가 관리자인지"만 확인할 수 있어요.
      allow get: if request.auth != null && request.auth.token.email.lower() == email;
      allow list, write: if false;
    }

    match /rsvps/{id} {
      function validData() {
        let d = request.resource.data;
        return d.keys().hasOnly(['name', 'pinHash', 'attending', 'eta', 'message', 'createdAt', 'updatedAt'])
          && d.name is string && d.name.size() > 0 && d.name.size() <= 20
          && d.pinHash is string && d.pinHash.size() == 64
          && d.attending in ['yes', 'maybe', 'no']
          && (!('eta' in d) || d.eta in ['', '1시', '2시쯤', '3시쯤', '4시 이후', '아직 몰라요'])
          && (!('message' in d) || (d.message is string && d.message.size() <= 150));
      }

      // 각자 자기 응답만 불러올 수 있고, 전체 명단은 관리자만 볼 수 있어요.
      allow get: if true;
      allow list: if isAdmin();
      allow create: if validData();
      // 비밀번호(pinHash)와 이름은 처음 등록한 값에서 바꿀 수 없어요.
      allow update: if validData()
        && request.resource.data.pinHash == resource.data.pinHash
        && request.resource.data.name == resource.data.name;
      allow delete: if false;
    }
  }
}
