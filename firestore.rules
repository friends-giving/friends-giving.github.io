rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 관리자: Firestore 콘솔에서 admins 컬렉션에 "구글 이메일(소문자)"을 문서 ID로 추가하면 돼요.
    function isAdmin() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && exists(/databases/$(database)/documents/admins/$(request.auth.token.email.lower()));
    }

    match /admins/{email} {
      // 로그인한 사람이 "내가 관리자인지"만 확인할 수 있어요.
      allow get: if request.auth != null && request.auth.token.email.lower() == email;
      allow list, write: if false;
    }

    // ── Best Dish Vote ─────────────────────────────────────
    // config/vote.phase: 'hidden'(비공개) → 'open'(등록+투표) → 'closed'(마감) → 'results'(결과 공개). 문서가 없으면 'hidden'.
    // 결과 공개 때 관리자가 득표수(results)만 올려요. 누가 누구를 찍었는지는 관리자만 볼 수 있어요.
    function votePhase() {
      let p = /databases/$(database)/documents/config/vote;
      return exists(p) ? get(p).data.phase : 'hidden';
    }
    // 이름(rsvp 문서 ID) + 비밀번호(pinHash)가 RSVP와 일치하는지
    function isVoter(rsvpId, pinHash) {
      let r = /databases/$(database)/documents/rsvps/$(rsvpId);
      return rsvpId is string && exists(r) && get(r).data.pinHash == pinHash;
    }

    match /config/{doc} {
      allow read: if true;
      allow write: if isAdmin() && doc == 'vote'
        && request.resource.data.keys().hasOnly(['phase', 'results'])
        && request.resource.data.phase in ['hidden', 'open', 'closed', 'results'];
    }

    match /dishes/{dishId} {
      function validDish() {
        let d = request.resource.data;
        return d.keys().hasOnly(['name', 'chef', 'desc', 'emoji', 'createdBy', 'pinHash', 'createdAt', 'deleted'])
          && (!('deleted' in d) || d.deleted is bool)
          && d.name is string && d.name.size() > 0 && d.name.size() <= 40
          && d.chef is string && d.chef.size() > 0 && d.chef.size() <= 20
          && d.desc is string && d.desc.size() <= 80
          && d.emoji is string && d.emoji.size() <= 8;
      }
      allow read: if true;
      allow create: if votePhase() == 'open' && validDish()
        && isVoter(request.resource.data.createdBy, request.resource.data.pinHash)
        && request.resource.data.createdAt == request.time;
      // 등록한 사람만 수정·삭제 가능 (본인 삭제는 deleted: true 로 표시), 완전 삭제는 관리자만
      allow update: if votePhase() == 'open' && validDish()
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && isVoter(resource.data.createdBy, request.resource.data.pinHash);
      allow delete: if isAdmin();
    }

    // 표: RSVP 1명당 1표, 마감 전까지 변경 가능 (관리자 집계에서 같은 사람의 표는 최신 1개만 셈)
    match /votes/{voteKey} {
      function validVote() {
        let d = request.resource.data;
        return d.keys().hasOnly(['voter', 'pinHash', 'dishId', 'updatedAt'])
          && isVoter(d.voter, d.pinHash)
          && d.dishId is string
          && (d.dishId == ''   // '' = 투표 취소
            || (exists(/databases/$(database)/documents/dishes/$(d.dishId))
              && get(/databases/$(database)/documents/dishes/$(d.dishId)).data.get('deleted', false) == false))
          && d.updatedAt == request.time;
      }
      allow get: if true;          // 문서 ID는 이름+비밀번호로만 만들 수 있어서 본인만 찾을 수 있어요
      allow list: if isAdmin();
      // 마감 전까지는 본인 표를 다른 음식으로 바꿀 수 있어요
      allow create: if votePhase() == 'open' && validVote();
      allow update: if votePhase() == 'open' && validVote()
        && request.resource.data.voter == resource.data.voter;
      allow delete: if false;
    }

    // 공개 참석자 명단: rsvps에서 비밀번호(pinHash)만 뺀 복사본. rsvps 내용과 똑같을 때만 저장돼요.
    match /guests/{id} {
      function mirrorsRsvp() {
        let r = getAfter(/databases/$(database)/documents/rsvps/$(id)).data;
        let d = request.resource.data;
        return d.keys().hasOnly(['name', 'attending', 'eta', 'message', 'party', 'updatedAt'])
          && d.name == r.name
          && d.attending == r.attending
          && d.get('eta', '') == r.get('eta', '')
          && d.get('message', '') == r.get('message', '')
          && d.get('party', []) == r.get('party', [])
          && d.updatedAt == request.time;
      }
      allow read: if true;
      allow create, update: if mirrorsRsvp();
      allow delete: if isAdmin();
    }

    match /rsvps/{id} {
      function validData() {
        let d = request.resource.data;
        return d.keys().hasOnly(['name', 'pinHash', 'attending', 'eta', 'message', 'party', 'createdAt', 'updatedAt'])
          && d.name is string && d.name.size() > 0 && d.name.size() <= 20
          && d.pinHash is string && d.pinHash.size() == 64
          && d.attending in ['yes', 'maybe', 'no']
          && (!('eta' in d) || d.eta in ['', '1시', '2시쯤', '3시쯤', '4시 이후', '아직 몰라요'])
          && (!('message' in d) || (d.message is string && d.message.size() <= 150))
          && (!('party' in d) || (d.party is list && d.party.size() <= 5));   // 함께 오는 사람 이름 (최대 5명)
      }

      // 각자 자기 응답만 불러올 수 있고, 전체 명단은 관리자만 볼 수 있어요.
      allow get: if true;
      allow list: if isAdmin();
      allow create: if validData();
      // 비밀번호(pinHash)와 이름은 처음 등록한 값에서 바꿀 수 없어요.
      allow update: if validData()
        && request.resource.data.pinHash == resource.data.pinHash
        && request.resource.data.name == resource.data.name;
      allow delete: if false;
    }
  }
}
